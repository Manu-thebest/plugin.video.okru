<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Ajustes de OK.ru.

  ESTO ERA EL PROBLEMA, y era nuestro, no de tu Kodi:
   - La version desplegada llevaba <settings version="2">. Con version="2" Kodi
     espera los nombres nuevos de tipo (boolean/integer/string) y RECHAZA los
     clasicos como "enum". Al fallar UN ajuste se rompe el grupo entero y la
     pantalla sale vacia, con etiquetas de otras pantallas ("#FF000000", "??").
   - Habia DOS <default> seguidos en servicio_url: eso deja el ajuste a cadena
     vacia (asi se leian las cookies a 0 caracteres).

  Formato correcto = el CLASICO, el mismo que usan los otros 46 addons de este
  Kodi (alfa, amazon-test, movistarplus...): sin atributo version, tipos
  bool / enum / integer / labelenum / text, y etiquetas en texto directo.
-->
<settings>
    <category label="Reproducción">
        <!-- enum guarda el INDICE de la lista (0-3). El addon lo espera asi. -->
        <setting id="modo_reproduccion" type="enum" label="Cómo reproducir"
                 values="Preguntar cada vez|HLS (calidad automática)|MP4 (recomendado)|Solo MP4"
                 default="2"/>
        <!-- labelenum guarda el TEXTO de la opcion. -->
        <setting id="calidad_defecto" type="labelenum" label="Calidad por defecto"
                 values="144p (la más baja)|240p|480p|720p (HD)|1080p (Full HD)|1440p (2K)|2160p (4K)"
                 default="720p (HD)"/>
    </category>

    <category label="Idioma y resultados">
        <setting id="idioma_preferido" type="labelenum" label="Idioma preferido"
                 values="Castellano|Latino|VOSE|Cualquiera" default="Castellano"/>
        <setting id="resultados" type="integer" label="Cuántos resultados por búsqueda" default="30">
            <level>0</level>
            <constraints>
                <minimum>10</minimum>
                <maximum>100</maximum>
                <step>10</step>
            </constraints>
        </setting>
        <setting id="mostrar_caratulas" type="bool" label="Mostrar carátulas" default="true"/>
    </category>

    <category label="Sesión de ok.ru (necesaria para buscar)">
        <setting id="usar_sesion" type="bool"
                 label="Buscar con mi sesión de ok.ru" default="true"/>
        <setting id="servicio_url" type="text" label="Dirección del buscador"
                 default="http://127.0.0.1:9223"/>
        <setting id="cookies_okru" type="text"
                 label="Sesión de ok.ru (cookies) · solo si no hay buscador" default=""/>
    </category>

    <category label="Descargas">
        <!-- type="folder" da botón para elegir la carpeta: es el formato que usan
             los addons que funcionan en este Kodi (retrodeck, etc.).
             Para descargar un vídeo: menú contextual sobre él -> "Descargar este vídeo". -->
        <setting id="carpeta_descargas" type="folder"
                 label="Carpeta donde guardar los vídeos" source=""/>
    </category>
</settings>
